# ===== مطلوب في الإنتاج =====
# توكن بوت تيليجرام (من @BotFather) — بدونه لا يستطيع أي لاعب الدخول.
TELEGRAM_BOT_TOKEN=

# مفتاح توقيع جلسات اللعبة. في الإنتاج يجب أن يكون نصًا عشوائيًا طويلًا،
# وإلا رفض الخادم الإقلاع. توليده: openssl rand -hex 32
SESSION_SECRET=

# ===== اختياري =====
# منفذ الاستماع. خدمات الاستضافة (مثل Render) تضبطه تلقائيًا.
PORT=3000
HOST=0.0.0.0

# MongoDB — اتركه فارغًا ليعمل المشروع بتخزين مؤقت في الذاكرة.
MONGODB_URI=
MONGODB_DB=riqaa

# أصول مسموح بها لطلبات المتصفح. عند تقديم الواجهة من نفس الخادم لا حاجة لتغييره.
CORS_ORIGIN=*

# أقصى عمر مقبول لبيانات تيليجرام بالثواني.
INIT_DATA_MAX_AGE=86400

# ===== تطوير فقط =====
# دخول ضيف بلا تيليجرام. مغلق تلقائيًا عندما NODE_ENV=production،
# ولا يُفتح في الإنتاج إلا بضبطه صراحةً على true (غير مستحسن).
DEV_ALLOW_GUEST=true
