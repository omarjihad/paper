# توكن بوت تيليجرام (من @BotFather) — مطلوب للتحقق الحقيقي من initData
TELEGRAM_BOT_TOKEN=

# مفتاح توقيع جلسات اللعبة (غيّره في الإنتاج)
SESSION_SECRET=change-me-in-production

# وضع التطوير: يسمح بالدخول بضيف عند فتح اللعبة خارج تيليجرام
DEV_ALLOW_GUEST=true

# MongoDB — اتركه فارغًا ليعمل المشروع بذاكرة مؤقتة بدون قاعدة بيانات
MONGODB_URI=
MONGODB_DB=riqaa

PORT=3000
HOST=0.0.0.0

# أصول مسموح بها لطلبات المتصفح أثناء التطوير
CORS_ORIGIN=*
